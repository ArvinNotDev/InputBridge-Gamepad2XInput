QMainWindow {
    background-color: #1e1e28;
}

QWidget {
    font-family: "Segoe UI";
}

QLabel {
    color: #ffffff;
    font-weight: 500;
}

QPushButton {
    min-height: 30px;
    padding: 5px 12px;
    border-radius: 7px;
    border: 1px solid #45455f;
    background-color: #303041;
    color: #eeeeff;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #3b3b53;
    border-color: #6d75d9;
}

QPushButton:pressed {
    background-color: #262638;
}

QPushButton:disabled {
    background-color: #292936;
    color: #68687d;
    border-color: #38384a;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #282836;
    color: #f2f2ff;
    border: 1px solid #46465d;
    border-radius: 7px;
    padding: 6px 8px;
    selection-background-color: #5a5af0;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #6f7cff;
}

QCheckBox {
    spacing: 8px;
    padding: 3px 0;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #343448;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: #7378ff;
}

#sidebar_menu {
    border: none;
    background: transparent;
    padding: 4px 0;
}

#sidebar_menu::item {
    padding: 12px 14px;
    margin: 2px 0;
    border-radius: 8px;
    background: transparent;
}

#sidebar_menu::item:selected {
    background-color: #41418d;
}

#sidebar_menu::item:hover {
    background-color: #30304a;
}

QListWidget {
    background-color: #2c2c38;
    border: 2px solid #444455;
    border-radius: 8px;
    color: #ffffff;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    padding: 12px 10px;
    margin: 2px 0;
    color: #ffffff;
    border-radius: 6px;
    background-color: #2c2c38;
}

QListWidget::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    color: #ffffff;
    font-weight: 600;
}

QListWidget::item:hover {
    background-color: #3a3a5a;
    color: #ffffff;
}

QScrollBar:vertical {
    border: none;
    background: #2c2c38;
    width: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7a7af8, stop:1 #5a5af0
    );
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}
QComboBox {
    background-color: #2b2b3a;
    border: 2px solid #555566;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 28px;
    color: #dddddd;
}

QComboBox:hover {
    border-color: #5390ff;
}

QComboBox:focus {
    border-color: #85c1ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #555566;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    margin-right: 8px;
}

/* Dropdown List */
QComboBox QAbstractItemView {
    background-color: #2b2b3a;
    border: 2px solid #555566;
    border-radius: 6px;
    padding: 6px;
    color: #dddddd;
    selection-background-color: #5390ff;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 10px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3c3c4f;
    color: #ffffff;
}

QComboBox QAbstractItemView::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #85c1ff, stop:1 #5390ff
    );
    color: #ffffff;
}

/* ===================== Profiles Page ===================== */
QGroupBox {
    border: 1px solid #3a3a4a;
    border-radius: 6px;
    margin-top: 8px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
    color: #ccccdd;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #aaaaBB;
}

QPushButton#profiles_activate_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton#profiles_activate_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7a7af8, stop:1 #5a5af0
    );
}

QPushButton#profiles_new_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_new_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7a7af8, stop:1 #5a5af0
    );
}

QPushButton#profiles_import_btn, QPushButton#profiles_export_btn {
    background-color: #292938;
    color: #b8b8d8;
    border: 1px solid #45455f;
    border-radius: 7px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#profiles_import_btn:hover, QPushButton#profiles_export_btn:hover {
    background-color: #35354c;
    color: #ffffff;
    border-color: #6c7cff;
}

QListWidget#profiles_list {
    background-color: #252530;
    border: 1px solid #3f3f55;
    border-radius: 12px;
    padding: 8px;
}

QListWidget#profiles_list::item {
    padding: 12px 10px;
    margin: 3px 0;
    border-radius: 8px;
    background-color: transparent;
}

QListWidget#profiles_list::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4545a9, stop:1 #303078
    );
}

QPushButton#profiles_delete_btn {
    background-color: #3a2028;
    color: #ff6b6b;
    border: 1px solid #5a2030;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_delete_btn:hover {
    background-color: #4a2030;
    border-color: #ff6b6b;
}

QSplitter::handle {
    background-color: #3a3a4a;
    width: 2px;
    margin: 8px 4px;
    border-radius: 1px;
}

QPushButton#settings_save_profile {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4ecdc4, stop:1 #2eaa9b
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#settings_save_profile:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #6ee0d8, stop:1 #4ecdc4
    );
}

#settings_profile_menu {
    background-color: #2c2c38;
    border: 2px solid #444455;
    border-radius: 8px;
    padding: 6px;
    color: #dddddd;
}

#settings_profile_menu QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    color: #dddddd;
}

#settings_profile_menu QMenu::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    color: #ffffff;
}

#settings_profile_menu QMenu::separator {
    height: 1px;
    background: #444455;
    margin: 4px 8px;
}

QFrame#about_hero {
    background-color: #292942;
    border: 1px solid #484875;
    border-radius: 18px;
}

QLabel#about_badge {
    color: #8f9bff;
    font-size: 11px;
    font-weight: 800;
}

QLabel#about_title {
    color: #ffffff;
    font-size: 25px;
    font-weight: 800;
}

QLabel#about_version {
    color: #a8f0df;
    background: #234942;
    border-radius: 8px;
    padding: 5px 10px;
    font-weight: 700;
}

QLabel#about_tagline, QLabel#about_body {
    color: #b8b8cc;
    font-size: 13px;
}

QFrame#about_info_card {
    background-color: #252530;
    border: 1px solid #3f3f55;
    border-radius: 14px;
}

QLabel#about_section_title {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
}

QLabel#about_meta, QLabel#about_tip {
    color: #9292ad;
    font-size: 12px;
}

QPushButton#about_primary_btn, QPushButton#about_secondary_btn {
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 700;
}

QPushButton#about_primary_btn {
    background-color: #5a5af0;
    color: #ffffff;
    border: 1px solid #7373ff;
}

QPushButton#about_primary_btn:hover { background-color: #7070ff; }

QPushButton#about_secondary_btn {
    background-color: transparent;
    color: #a8b9ff;
    border: 1px solid #555b8a;
}

QPushButton#about_secondary_btn:hover { background-color: #30304b; }

/* Sidebar avatar */
#sidebar_avatar_container {
    background-color: #252530;
    border-radius: 10px;
    border: 1px solid #333345;
}

#sidebar_profile_name {
    color: #eeeeff;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#github_button {
    background-color: #2c2c3a;
    color: #aaaacc;
    border: 1px solid #444466;
    border-radius: 6px;
    padding: 8px 6px;
    font-size: 11px;
}

QPushButton#github_button:hover {
    background-color: #3a3a50;
    color: #ffffff;
    border-color: #5a5af0;
}

/* Profile image buttons */
QPushButton#profiles_set_image_btn {
    background-color: #2c2c3a;
    color: #aaaacc;
    border: 1px solid #444466;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

QPushButton#profiles_set_image_btn:hover {
    background-color: #3a3a5a;
    color: #ddddff;
    border-color: #5a5af0;
}

QPushButton#profiles_remove_image_btn {
    background-color: #3a2028;
    color: #ff6b6b;
    border: 1px solid #5a2030;
    border-radius: 4px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#profiles_remove_image_btn:hover {
    background-color: #5a2030;
    border-color: #ff6b6b;
}

QPushButton#profiles_remove_image_btn:disabled {
    background-color: #2c2c38;
    color: #555566;
    border-color: #3a3a4a;
}

QPushButton#profiles_save_desc_btn {
    background-color: #2c2c3a;
    color: #aaaacc;
    border: 1px solid #444466;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
}

QPushButton#profiles_save_desc_btn:hover {
    background-color: #3a3a5a;
    color: #ddddff;
    border-color: #5a5af0;
}

QPushButton#profiles_save_desc_btn:disabled {
    background-color: #252530;
    color: #555566;
    border-color: #333345;
}

QTextEdit {
    background-color: #252530;
    color: #dddddd;
    border: 1px solid #3a3a4a;
    border-radius: 4px;
    padding: 6px;
}
