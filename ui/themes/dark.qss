QMainWindow {
    background-color: #1e1e28;
}

QWidget {
    font-family: "Segoe UI";
}

QLabel {
    color: #ffffff;
    font-weight: 500;
}

QPushButton {
    min-height: 30px;
    padding: 5px 12px;
    border-radius: 7px;
    border: 1px solid #45455f;
    background-color: #303041;
    color: #eeeeff;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #3b3b53;
    border-color: #635bff;
}

QPushButton:pressed {
    background-color: #262638;
}

QPushButton:disabled {
    background-color: #292936;
    color: #68687d;
    border-color: #38384a;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #282836;
    color: #f2f2ff;
    border: 1px solid #46465d;
    border-radius: 7px;
    padding: 6px 8px;
    selection-background-color: #635bff;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #38cde1;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 22px;
    background-color: #34344a;
    border-left: 1px solid #4b4b65;
}

QAbstractSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #505070;
}

QCheckBox {
    spacing: 8px;
    padding: 3px 0;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #343448;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: #635bff;
}

#sidebar_menu {
    border: none;
    background: transparent;
    padding: 4px 0;
}

#sidebar_menu::item {
    padding: 12px 14px;
    margin: 2px 0;
    border-radius: 8px;
    background: transparent;
}

#sidebar_menu::item:selected {
    background-color: #41418d;
}

#sidebar_menu::item:hover {
    background-color: #30304a;
}

QListWidget {
    background-color: #2c2c38;
    border: 2px solid #444455;
    border-radius: 8px;
    color: #ffffff;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    padding: 12px 10px;
    margin: 2px 0;
    color: #ffffff;
    border-radius: 6px;
    background-color: #2c2c38;
}

QListWidget::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #635bff, stop:1 #4d46e6
    );
    color: #ffffff;
    font-weight: 600;
}

QListWidget::item:hover {
    background-color: #3a3a5a;
    color: #ffffff;
}

QScrollBar:vertical {
    border: none;
    background: #2c2c38;
    width: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #635bff, stop:1 #4d46e6
    );
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #38cde1, stop:1 #635bff
    );
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}
QComboBox {
    background-color: #2b2b3a;
    border: 2px solid #555566;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 28px;
    color: #dddddd;
}

QComboBox:hover {
    border-color: #5390ff;
}

QComboBox:focus {
    border-color: #85c1ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #555566;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    margin-right: 8px;
}

/* Dropdown List */
QComboBox QAbstractItemView {
    background-color: #2b2b3a;
    border: 2px solid #555566;
    border-radius: 6px;
    padding: 6px;
    color: #dddddd;
    selection-background-color: #5390ff;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 10px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3c3c4f;
    color: #ffffff;
}

QComboBox QAbstractItemView::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #85c1ff, stop:1 #5390ff
    );
    color: #ffffff;
}

/* ===================== Profiles Page ===================== */
QGroupBox {
    border: 1px solid #3a3a4a;
    border-radius: 6px;
    margin-top: 8px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
    color: #ccccdd;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #aaaaBB;
}

QPushButton#profiles_activate_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #635bff, stop:1 #4d46e6
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton#profiles_activate_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #38cde1, stop:1 #635bff
    );
}

QPushButton#profiles_new_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #635bff, stop:1 #4d46e6
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_new_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #38cde1, stop:1 #635bff
    );
}

QPushButton#profiles_import_btn, QPushButton#profiles_export_btn {
    background-color: #292938;
    color: #b8b8d8;
    border: 1px solid #45455f;
    border-radius: 7px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#profiles_import_btn:hover, QPushButton#profiles_export_btn:hover {
    background-color: #35354c;
    color: #ffffff;
    border-color: #635bff;
}

QListWidget#profiles_list {
    background-color: #252530;
    border: 1px solid #3f3f55;
    border-radius: 12px;
    padding: 8px;
}

QListWidget#profiles_list::item {
    padding: 12px 10px;
    margin: 3px 0;
    border-radius: 8px;
    background-color: transparent;
}

QListWidget#profiles_list::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4545a9, stop:1 #303078
    );
}

QPushButton#profiles_delete_btn {
    background-color: #3a2028;
    color: #ff6b6b;
    border: 1px solid #5a2030;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_delete_btn:hover {
    background-color: #4a2030;
    border-color: #ff6b6b;
}

QSplitter::handle {
    background-color: #3a3a4a;
    width: 2px;
    margin: 8px 4px;
    border-radius: 1px;
}

QPushButton#settings_save_profile {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4ecdc4, stop:1 #2eaa9b
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#settings_save_profile:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #6ee0d8, stop:1 #4ecdc4
    );
}

#settings_profile_menu {
    background-color: #2c2c38;
    border: 2px solid #444455;
    border-radius: 8px;
    padding: 6px;
    color: #dddddd;
}

#settings_profile_menu QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    color: #dddddd;
}

#settings_profile_menu QMenu::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #635bff, stop:1 #4d46e6
    );
    color: #ffffff;
}

#settings_profile_menu QMenu::separator {
    height: 1px;
    background: #444455;
    margin: 4px 8px;
}

QFrame#about_hero {
    background-color: #292942;
    border: 1px solid #484875;
    border-radius: 18px;
}

QLabel#about_badge {
    color: #8f9bff;
    font-size: 11px;
    font-weight: 800;
}

QLabel#about_title {
    color: #ffffff;
    font-size: 25px;
    font-weight: 800;
}

QLabel#about_version {
    color: #a8f0df;
    background: #234942;
    border-radius: 8px;
    padding: 5px 10px;
    font-weight: 700;
}

QLabel#about_tagline, QLabel#about_body {
    color: #b8b8cc;
    font-size: 13px;
}

QFrame#about_info_card {
    background-color: #252530;
    border: 1px solid #3f3f55;
    border-radius: 14px;
}

QLabel#about_section_title {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
}

QLabel#about_meta, QLabel#about_tip {
    color: #9292ad;
    font-size: 12px;
}

QPushButton#about_primary_btn, QPushButton#about_secondary_btn {
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 700;
}

QPushButton#about_primary_btn {
    background-color: #635bff;
    color: #ffffff;
    border: 1px solid #7373ff;
}

QPushButton#about_primary_btn:hover { background-color: #7070ff; }

QPushButton#about_secondary_btn {
    background-color: transparent;
    color: #a8b9ff;
    border: 1px solid #555b8a;
}

QPushButton#about_secondary_btn:hover { background-color: #30304b; }

/* Sidebar avatar */
#sidebar_avatar_container {
    background-color: #252530;
    border-radius: 10px;
    border: 1px solid #333345;
}

#sidebar_profile_name {
    color: #eeeeff;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#github_button {
    background-color: #2c2c3a;
    color: #aaaacc;
    border: 1px solid #444466;
    border-radius: 6px;
    padding: 8px 6px;
    font-size: 11px;
}

QPushButton#github_button:hover {
    background-color: #3a3a50;
    color: #ffffff;
    border-color: #635bff;
}

/* Profile image buttons */
QPushButton#profiles_set_image_btn {
    background-color: #2c2c3a;
    color: #aaaacc;
    border: 1px solid #444466;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

QPushButton#profiles_set_image_btn:hover {
    background-color: #3a3a5a;
    color: #ddddff;
    border-color: #635bff;
}

QPushButton#profiles_remove_image_btn {
    background-color: #3a2028;
    color: #ff6b6b;
    border: 1px solid #5a2030;
    border-radius: 4px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#profiles_remove_image_btn:hover {
    background-color: #5a2030;
    border-color: #ff6b6b;
}

QPushButton#profiles_remove_image_btn:disabled {
    background-color: #2c2c38;
    color: #555566;
    border-color: #3a3a4a;
}

QPushButton#profiles_save_desc_btn {
    background-color: #2c2c3a;
    color: #aaaacc;
    border: 1px solid #444466;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
}

QPushButton#profiles_save_desc_btn:hover {
    background-color: #3a3a5a;
    color: #ddddff;
    border-color: #635bff;
}

QPushButton#profiles_save_desc_btn:disabled {
    background-color: #252530;
    color: #555566;
    border-color: #333345;
}

QTextEdit {
    background-color: #252530;
    color: #dddddd;
    border: 1px solid #3a3a4a;
    border-radius: 4px;
    padding: 6px;
}

QFrame#lightbar_preview {
    border: 1px solid #77778a;
    border-radius: 5px;
}


/* ===================== VPadConnect modern shell ===================== */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0d1422, stop:0.55 #111b2c, stop:1 #1d1730);
}

#app_root {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #101827, stop:0.58 #141d30, stop:1 #21182f);
}

#app_header {
    background: transparent;
}

#brand_mark {
    border: 1px solid #777cff;
    border-radius: 14px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 900;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #536dfe, stop:0.52 #7958e8, stop:1 #10b8c8);
}

#brand_title {
    color: #f6f8ff;
    font-size: 20px;
    font-weight: 800;
}

#brand_subtitle {
    color: #8e9bb8;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 2px;
}

#profile_chip {
    background: rgba(255,255,255,0.035);
    border: 1px solid #303c55;
    border-radius: 15px;
}

#sidebar_profile_name {
    color: #eef2ff;
    font-size: 12px;
    font-weight: 700;
}

#sidebar_profile_label {
    color: #8f9db9;
    font-size: 10px;
}

QListWidget#top_navigation {
    background: rgba(255,255,255,0.035);
    border: 1px solid #2b3851;
    border-radius: 15px;
    padding: 5px;
    outline: none;
}

QListWidget#top_navigation::item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #aab6ce;
    padding: 11px 15px;
    margin: 1px 2px;
    font-size: 10pt;
    font-weight: 600;
}

QListWidget#top_navigation::item:hover {
    background: rgba(112,130,255,0.12);
    border-color: #3b4968;
    color: #f7f8ff;
}

QListWidget#top_navigation::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f5fe8, stop:0.55 #6758dc, stop:1 #8058d9);
    border: 1px solid #8586ff;
    color: #ffffff;
    font-weight: 700;
}

QStackedWidget#content_stack {
    background: rgba(12,18,31,0.22);
    border: 1px solid #293750;
    border-radius: 18px;
}

QPushButton {
    background: #202b40;
    border: 1px solid #3b4964;
    border-radius: 9px;
    color: #e8edff;
    padding: 7px 13px;
    font-weight: 600;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #364b80, stop:1 #4b397b);
    border-color: #7887ff;
}

QPushButton:pressed {
    background: #252c49;
}

QPushButton#github_button {
    background: transparent;
    border: 1px solid #34425c;
    color: #b7c4de;
    border-radius: 10px;
    padding: 8px 14px;
}

QPushButton#github_button:hover {
    background: rgba(118,137,255,0.12);
    border-color: #6b7cff;
    color: #ffffff;
}

QPushButton#quit_button {
    background: rgba(255,255,255,0.035);
    border: 1px solid #3b4964;
    color: #a9b7d1;
    border-radius: 11px;
    font-size: 17px;
    padding: 5px;
}

QPushButton#quit_button:hover {
    background: #4a2538;
    border-color: #d66a90;
    color: #ffffff;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #192438;
    color: #edf2ff;
    border: 1px solid #35435e;
    border-radius: 9px;
    selection-background-color: #625ee8;
    padding: 7px 10px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #7b83ff;
    background: #1b2942;
}

QGroupBox {
    background: rgba(255,255,255,0.018);
    border: 1px solid #2f3c55;
    border-radius: 12px;
    margin-top: 13px;
    padding: 14px 10px 10px 10px;
    color: #cbd5eb;
}

QGroupBox::title {
    color: #bac7e4;
    padding: 0 7px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
    border-radius: 5px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #465577;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #7483ff;
}


/* Focused navigation refinement: lightweight tabs, no container frame. */
#app_root {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #101827, stop:0.68 #131b2b, stop:1 #1a1728);
}

#brand_mark {
    border: none;
    border-radius: 11px;
    font-size: 14px;
}

#brand_title {
    font-size: 19px;
    font-weight: 750;
}

#profile_chip {
    background: transparent;
    border: none;
    border-radius: 0;
}

QTabBar#top_navigation {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

QTabBar#top_navigation::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #929fb7;
    padding: 10px 13px 9px 13px;
    margin: 0 3px 0 0;
    min-width: 58px;
    font-size: 10pt;
    font-weight: 600;
}

QTabBar#top_navigation::tab:hover {
    background: rgba(135,149,255,0.07);
    border-bottom-color: #414d6b;
    color: #e9edfa;
}

QTabBar#top_navigation::tab:selected {
    background: transparent;
    border: none;
    border-bottom: 2px solid #8286ff;
    color: #f6f7ff;
    font-weight: 700;
}

QTabBar#top_navigation QToolButton {
    background: transparent;
    border: none;
    color: #9daac3;
    min-width: 22px;
    padding: 0;
}

QTabBar#top_navigation QToolButton:hover {
    background: rgba(135,149,255,0.10);
    border-radius: 6px;
}

QStackedWidget#content_stack {
    background: transparent;
    border: none;
    border-radius: 0;
}


/* Frameless Apple-inspired title bar */
QPushButton#window_minimize, QPushButton#window_maximize, QPushButton#window_close {
    border: none; border-radius: 7px; padding: 0; min-width: 13px; max-width: 13px;
    min-height: 13px; max-height: 13px;
}
QPushButton#window_minimize { background: #f6c65b; }
QPushButton#window_maximize { background: #35c76b; }
QPushButton#window_close { background: #ff5f57; }
QPushButton#window_minimize:hover { background: #ffda79; }
QPushButton#window_maximize:hover { background: #61dc89; }
QPushButton#window_close:hover { background: #ff837d; }
QPushButton#profile_chip { text-align: left; padding: 3px 8px; }
QPushButton#profile_chip:hover { background: rgba(135,149,255,0.12); border-color: #4b5d81; }
QPushButton#settings_gear { background: #192338; border: 1px solid #33435f; border-radius: 12px;
    padding: 0; color: #dce6fb; font-size: 21px; font-weight: 500; }
QPushButton#settings_gear:hover { background: #273958; border-color: #6177a5; }
QTabBar#settings_navigation { background: transparent; border: none; padding: 0; margin: 0 0 8px 0; }
QTabBar#settings_navigation::tab { background: transparent; color: #929fb7; border: none;
    border-bottom: 2px solid transparent; padding: 8px 14px; margin-right: 5px; font-weight: 650; }
QTabBar#settings_navigation::tab:hover { color: #eef3ff; background: rgba(135,149,255,0.08); }
QTabBar#settings_navigation::tab:selected { color: #ffffff; border-bottom-color: #746dff; }


/* Final title-bar refinements */
QPushButton#window_close, QPushButton#window_minimize, QPushButton#window_maximize {
    min-width: 14px; max-width: 14px; min-height: 14px; max-height: 14px;
    border: none; border-radius: 7px; padding: 0; margin: 0;
}
QPushButton#profile_chip {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #202d45, stop:1 #18243a);
    border: 1px solid #3b4e6d; border-radius: 13px;
    padding: 3px 11px; text-align: left;
}
QPushButton#profile_chip:hover {
    background: #2a3a58; border-color: #6279a2;
}
QPushButton#settings_gear {
    background: #192338; border: 1px solid #33435f; border-radius: 12px;
    padding: 0; color: #dce6fb; font-size: 21px; font-weight: 500;
}
QPushButton#settings_gear:hover { background: #273958; border-color: #6177a5; }
#sidebar_profile_name { color: #f4f7ff; font-size: 12px; font-weight: 750; }
#sidebar_profile_label { color: #afbdd4; font-size: 10px; }


/* Richer, coordinated desktop gradients */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0a1220, stop:0.28 #101c31, stop:0.58 #18213b,
        stop:0.82 #241d3c, stop:1 #102b3b);
}
#app_root {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0c1728, stop:0.25 #14233a, stop:0.52 #1b2440,
        stop:0.78 #27203f, stop:1 #12303b);
}
QStackedWidget#content_stack {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(20,34,55,0.94), stop:0.5 rgba(17,25,45,0.97),
        stop:1 rgba(32,25,52,0.94));
    border: 1px solid #344765;
    border-radius: 18px;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #263954, stop:0.55 #202d47, stop:1 #2c2547);
    border: 1px solid #405473;
    color: #edf3ff;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3d5d8c, stop:0.48 #4b4c91, stop:1 #376e83);
    border-color: #819bff;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #293d64, stop:1 #3b2d5a);
}
QPushButton#profile_chip {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #263955, stop:0.58 #1b2a43, stop:1 #302448);
    border: 1px solid #465d80;
    border-radius: 14px;
    padding: 4px 12px;
}
QPushButton#profile_chip:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #344f77, stop:1 #443363);
    border-color: #8297e8;
}
QPushButton#settings_gear {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #283b58, stop:1 #2e2549);
    border: 1px solid #4b5f83;
    border-radius: 12px;
}
QPushButton#settings_gear:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4265a0, stop:1 #6553a0);
    border-color: #98a6ff;
}
QListWidget#top_navigation::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #506cf5, stop:0.5 #7458e9, stop:1 #168fa9);
    border: 1px solid #8d9dff;
}
