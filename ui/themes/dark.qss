QMainWindow {
    background-color: #1e1e28;
}

QLabel {
    color: #ffffff;
    font-weight: 500;
}

QListWidget {
    background-color: #2c2c38;
    border: 2px solid #444455;
    border-radius: 8px;
    color: #ffffff;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    padding: 12px 10px;
    margin: 2px 0;
    color: #ffffff;
    border-radius: 6px;
    background-color: #2c2c38;
}

QListWidget::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    color: #ffffff;
    font-weight: 600;
}

QListWidget::item:hover {
    background-color: #3a3a5a;
    color: #ffffff;
}

QScrollBar:vertical {
    border: none;
    background: #2c2c38;
    width: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7a7af8, stop:1 #5a5af0
    );
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}
QComboBox {
    background-color: #2b2b3a;
    border: 2px solid #555566;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 28px;
    color: #dddddd;
}

QComboBox:hover {
    border-color: #5390ff;
}

QComboBox:focus {
    border-color: #85c1ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #555566;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    margin-right: 8px;
}

/* Dropdown List */
QComboBox QAbstractItemView {
    background-color: #2b2b3a;
    border: 2px solid #555566;
    border-radius: 6px;
    padding: 6px;
    color: #dddddd;
    selection-background-color: #5390ff;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 10px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3c3c4f;
    color: #ffffff;
}

QComboBox QAbstractItemView::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #85c1ff, stop:1 #5390ff
    );
    color: #ffffff;
}

/* ===================== Profiles Page ===================== */
QGroupBox {
    border: 1px solid #3a3a4a;
    border-radius: 6px;
    margin-top: 8px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
    color: #ccccdd;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #aaaaBB;
}

QPushButton#profiles_activate_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton#profiles_activate_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7a7af8, stop:1 #5a5af0
    );
}

QPushButton#profiles_new_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_new_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7a7af8, stop:1 #5a5af0
    );
}

QPushButton#profiles_delete_btn {
    background-color: #3a2028;
    color: #ff6b6b;
    border: 1px solid #5a2030;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_delete_btn:hover {
    background-color: #4a2030;
    border-color: #ff6b6b;
}

QSplitter::handle {
    background-color: #3a3a4a;
    width: 2px;
    margin: 8px 4px;
    border-radius: 1px;
}

QPushButton#settings_save_profile {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4ecdc4, stop:1 #2eaa9b
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#settings_save_profile:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #6ee0d8, stop:1 #4ecdc4
    );
}

#settings_profile_menu {
    background-color: #2c2c38;
    border: 2px solid #444455;
    border-radius: 8px;
    padding: 6px;
    color: #dddddd;
}

#settings_profile_menu QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    color: #dddddd;
}

#settings_profile_menu QMenu::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a5af0, stop:1 #3f3fd0
    );
    color: #ffffff;
}

#settings_profile_menu QMenu::separator {
    height: 1px;
    background: #444455;
    margin: 4px 8px;
}

/* Sidebar avatar */
#sidebar_avatar_container {
    background-color: #252530;
    border-radius: 10px;
    border: 1px solid #333345;
}

#sidebar_profile_name {
    color: #eeeeff;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#github_button {
    background-color: #2c2c3a;
    color: #aaaacc;
    border: 1px solid #444466;
    border-radius: 6px;
    padding: 8px 6px;
    font-size: 11px;
}

QPushButton#github_button:hover {
    background-color: #3a3a50;
    color: #ffffff;
    border-color: #5a5af0;
}

/* Profile image buttons */
QPushButton#profiles_set_image_btn {
    background-color: #2c2c3a;
    color: #aaaacc;
    border: 1px solid #444466;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

QPushButton#profiles_set_image_btn:hover {
    background-color: #3a3a5a;
    color: #ddddff;
    border-color: #5a5af0;
}

QPushButton#profiles_remove_image_btn {
    background-color: #3a2028;
    color: #ff6b6b;
    border: 1px solid #5a2030;
    border-radius: 4px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#profiles_remove_image_btn:hover {
    background-color: #5a2030;
    border-color: #ff6b6b;
}

QPushButton#profiles_remove_image_btn:disabled {
    background-color: #2c2c38;
    color: #555566;
    border-color: #3a3a4a;
}

QPushButton#profiles_save_desc_btn {
    background-color: #2c2c3a;
    color: #aaaacc;
    border: 1px solid #444466;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
}

QPushButton#profiles_save_desc_btn:hover {
    background-color: #3a3a5a;
    color: #ddddff;
    border-color: #5a5af0;
}

QPushButton#profiles_save_desc_btn:disabled {
    background-color: #252530;
    color: #555566;
    border-color: #333345;
}

QTextEdit {
    background-color: #252530;
    color: #dddddd;
    border: 1px solid #3a3a4a;
    border-radius: 4px;
    padding: 6px;
}
