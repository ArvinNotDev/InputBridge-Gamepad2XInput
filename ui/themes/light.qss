QMainWindow {
    background-color: #f2f2f5;
}

QWidget {
    font-family: "Segoe UI";
}

QLabel {
    color: #222222;
    font-weight: 500;
}

QPushButton {
    min-height: 30px;
    padding: 5px 12px;
    border-radius: 7px;
    border: 1px solid #cfd3e5;
    background-color: #f7f8fc;
    color: #30354f;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #edf0ff;
    border-color: #7b87d9;
}

QPushButton:pressed {
    background-color: #e0e4fb;
}

QPushButton:disabled {
    background-color: #eeeeF3;
    color: #a2a5b2;
    border-color: #ddddE6;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #252943;
    border: 1px solid #cfd3e5;
    border-radius: 7px;
    padding: 6px 8px;
    selection-background-color: #6171d2;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #6171d2;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 22px;
    background-color: #e9ebf6;
    border-left: 1px solid #cfd3e5;
}

QAbstractSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #d9ddf4;
}

QCheckBox {
    spacing: 8px;
    padding: 3px 0;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #dfe2f0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: #6171d2;
}

#sidebar_menu {
    border: none;
    background: transparent;
    padding: 4px 0;
}

#sidebar_menu::item {
    padding: 12px 14px;
    margin: 2px 0;
    border-radius: 8px;
    background: transparent;
}

#sidebar_menu::item:selected {
    background-color: #7481d7;
}

#sidebar_menu::item:hover {
    background-color: #e7eaff;
}

QListWidget {
    background-color: #ffffff;
    border: 2px solid #ccccdd;
    border-radius: 8px;
    color: #222222;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    padding: 12px 10px;
    margin: 2px 0;
    color: #222222;
    border-radius: 6px;
    background-color: #ffffff;
}

QListWidget::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #85c1ff, stop:1 #5390ff
    );
    color: #ffffff;
    font-weight: 600;
}

QListWidget::item:hover {
    background-color: #e8e8f0;
    color: #222222;
}

QScrollBar:vertical {
    border: none;
    background: #f0f0f5;
    width: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #85c1ff, stop:1 #5390ff
    );
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #a0d4ff, stop:1 #70b0ff
    );
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}
QComboBox {
    background-color: #ffffff;
    border: 2px solid #ccccdd;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 28px;
    color: #222222;
}

QComboBox:hover {
    border-color: #85c1ff;
}

QComboBox:focus {
    border-color: #5390ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #ccccdd;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    margin-right: 8px;
}

/* ===== THE IMPORTANT PART ===== */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 2px solid #ccccdd;
    border-radius: 6px;
    padding: 6px;
    color: #222222;
    selection-background-color: #5390ff;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 10px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #e8e8f0;
    color: #222222;
}

QComboBox QAbstractItemView::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #85c1ff, stop:1 #5390ff
    );
    color: #ffffff;
}

/* ===================== Profiles Page ===================== */
QGroupBox {
    border: 1px solid #ccccdd;
    border-radius: 6px;
    margin-top: 8px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
    color: #444455;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #666677;
}

QPushButton#profiles_activate_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #85c1ff, stop:1 #5390ff
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton#profiles_activate_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #a0d4ff, stop:1 #70b0ff
    );
}

QPushButton#profiles_new_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #85c1ff, stop:1 #5390ff
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_new_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #a0d4ff, stop:1 #70b0ff
    );
}

QPushButton#profiles_import_btn, QPushButton#profiles_export_btn {
    background-color: #f5f6fb;
    color: #555b78;
    border: 1px solid #cfd3e5;
    border-radius: 7px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#profiles_import_btn:hover, QPushButton#profiles_export_btn:hover {
    background-color: #e9ebf7;
    color: #252943;
    border-color: #7a86dc;
}

QListWidget#profiles_list {
    background-color: #ffffff;
    border: 1px solid #d7d9e5;
    border-radius: 12px;
    padding: 8px;
}

QListWidget#profiles_list::item {
    padding: 12px 10px;
    margin: 3px 0;
    border-radius: 8px;
    background-color: transparent;
}

QListWidget#profiles_list::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7e8be2, stop:1 #6070ce
    );
}

QPushButton#profiles_delete_btn {
    background-color: #fff0f0;
    color: #cc3333;
    border: 1px solid #ddaaaa;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_delete_btn:hover {
    background-color: #ffe0e0;
    border-color: #cc3333;
}

QSplitter::handle {
    background-color: #ccccdd;
    width: 2px;
    margin: 8px 4px;
    border-radius: 1px;
}

QPushButton#settings_save_profile {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4ecdc4, stop:1 #2eaa9b
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#settings_save_profile:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #6ee0d8, stop:1 #4ecdc4
    );
}

#settings_profile_menu {
    background-color: #ffffff;
    border: 2px solid #ccccdd;
    border-radius: 8px;
    padding: 6px;
    color: #222222;
}

#settings_profile_menu QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    color: #222222;
}

#settings_profile_menu QMenu::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #85c1ff, stop:1 #5390ff
    );
    color: #ffffff;
}

#settings_profile_menu QMenu::separator {
    height: 1px;
    background: #ccccdd;
    margin: 4px 8px;
}

QFrame#about_hero {
    background-color: #eef0ff;
    border: 1px solid #c9cef2;
    border-radius: 18px;
}

QLabel#about_badge {
    color: #5967c8;
    font-size: 11px;
    font-weight: 800;
}

QLabel#about_title {
    color: #20243a;
    font-size: 25px;
    font-weight: 800;
}

QLabel#about_version {
    color: #237665;
    background: #d9f2eb;
    border-radius: 8px;
    padding: 5px 10px;
    font-weight: 700;
}

QLabel#about_tagline, QLabel#about_body {
    color: #565b73;
    font-size: 13px;
}

QFrame#about_info_card {
    background-color: #ffffff;
    border: 1px solid #d7d9e5;
    border-radius: 14px;
}

QLabel#about_section_title {
    color: #252943;
    font-size: 16px;
    font-weight: 700;
}

QLabel#about_meta, QLabel#about_tip {
    color: #747991;
    font-size: 12px;
}

QPushButton#about_primary_btn, QPushButton#about_secondary_btn {
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 700;
}

QPushButton#about_primary_btn {
    background-color: #5d6fd9;
    color: #ffffff;
    border: 1px solid #7181e2;
}

QPushButton#about_primary_btn:hover { background-color: #7384eb; }

QPushButton#about_secondary_btn {
    background-color: transparent;
    color: #5363bf;
    border: 1px solid #a8b0dd;
}

QPushButton#about_secondary_btn:hover { background-color: #eff1ff; }

/* Sidebar avatar */
#sidebar_avatar_container {
    background-color: #ffffff;
    border-radius: 10px;
    border: 1px solid #dddddd;
}

#sidebar_profile_name {
    color: #222233;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#github_button {
    background-color: #f0f0f5;
    color: #555566;
    border: 1px solid #ccccdd;
    border-radius: 6px;
    padding: 8px 6px;
    font-size: 11px;
}

QPushButton#github_button:hover {
    background-color: #e4e4f0;
    color: #222233;
    border-color: #5390ff;
}

/* Profile image buttons */
QPushButton#profiles_set_image_btn {
    background-color: #f0f0f5;
    color: #555566;
    border: 1px solid #ccccdd;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

QPushButton#profiles_set_image_btn:hover {
    background-color: #e0e0ea;
    color: #222233;
    border-color: #5390ff;
}

QPushButton#profiles_remove_image_btn {
    background-color: #fff0f0;
    color: #cc3333;
    border: 1px solid #ddaaaa;
    border-radius: 4px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#profiles_remove_image_btn:hover {
    background-color: #ffe0e0;
    border-color: #cc3333;
}

QPushButton#profiles_remove_image_btn:disabled {
    background-color: #f5f5f8;
    color: #aaaaaa;
    border-color: #dddddd;
}

QPushButton#profiles_save_desc_btn {
    background-color: #f0f0f5;
    color: #555566;
    border: 1px solid #ccccdd;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
}

QPushButton#profiles_save_desc_btn:hover {
    background-color: #e0e0ea;
    color: #222233;
    border-color: #5390ff;
}

QPushButton#profiles_save_desc_btn:disabled {
    background-color: #f5f5f8;
    color: #aaaaaa;
    border-color: #dddddd;
}

QTextEdit {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #ccccdd;
    border-radius: 4px;
    padding: 6px;
}
